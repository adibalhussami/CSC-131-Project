# Neon connection strings (Neon dashboard > Connect). On Vercel, the Neon
# integration sets both of these for you.
# Pooled connection, used by the app at runtime:
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require"
# Direct (unpooled) connection, used by Prisma migrations:
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.us-west-2.aws.neon.tech/neondb?sslmode=require"

# Signs the login cookie. Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Used by `npm run seed` to create/update the admin login.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="choose-a-real-password"

# Optional: `npm run seed` also creates/updates this employee login if set.
# Employees can view the dashboard/records and log/delete pickups, but can't
# reach Bins & QR Codes, Cost, or CSV import (admin-only).
EMPLOYEE_USERNAME="employee"
EMPLOYEE_PASSWORD="choose-a-real-password"
