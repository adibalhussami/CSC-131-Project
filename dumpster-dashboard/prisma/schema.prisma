generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum WasteStream {
  LANDFILL
  RECYCLING
  ORGANICS
}

enum ContaminationLevel {
  NONE
  A_LITTLE
  A_LOT
}

// EMPLOYEE: view the dashboard and records, log/delete pickups.
// ADMIN: everything EMPLOYEE can do, plus bin registry, settings, drivers and CSV import.
// DRIVER: signs in with a username + 6-digit PIN and can only log pickups.
enum UserRole {
  EMPLOYEE
  ADMIN
  DRIVER
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String? // bcrypt hash, never the plain password. Null for drivers (PIN only).
  role         UserRole @default(EMPLOYEE)
  createdAt    DateTime @default(now())

  // Drivers: the name stamped on their pickups, and a bcrypt-hashed PIN.
  displayName    String?
  pinHash        String?
  active         Boolean   @default(true)
  // Bumped when a PIN is reset or the driver is deactivated, which signs out
  // every phone that driver was logged in on.
  sessionVersion Int       @default(0)
  failedLogins   Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?

  pickups PickupRecord[]

  @@map("app_user")
}

// Fullness status (GREEN/YELLOW/RED) is derived from fullnessPercent in lib/records.ts.
model PickupRecord {
  id              Int                @id @default(autoincrement())
  collectionDate  DateTime           @default(now())
  building        String
  location        String
  binId           String?
  driverName      String
  // Set when a signed-in driver logs the pickup. Older and imported records
  // only have driverName.
  driverId        Int?
  driver          User?              @relation(fields: [driverId], references: [id], onDelete: SetNull)
  wasteStream     WasteStream
  fullnessPercent Int
  contamination   ContaminationLevel
  overflow        Boolean            @default(false)
  comments        String?            @db.VarChar(1000)

  // Survey answers. Null/default on records logged before these questions existed.
  containerSize             String?
  serviceCompleted          Boolean @default(true)
  serviceNotCompletedReason String? @db.VarChar(200)
  maintenanceIssue          Boolean @default(false)
  maintenanceNotes          String? @db.VarChar(200)

  // Created by `npm run seed`. Settings > Data can delete just these.
  isDemo Boolean @default(false)

  @@index([collectionDate])
  @@index([driverId])
  @@map("pickup_record")
}

// Admin-editable $/pickup used by the Cost page (lib/costMetrics.ts). One row
// per waste stream; lib/costs.ts falls back to a default if a row is missing.
model CostRate {
  wasteStream  WasteStream @id
  usdPerPickup Float

  @@map("cost_rate")
}

// A physical bin with a printed QR code. Scanning the code opens the pickup
// form with this bin's location, ID and waste stream filled in.
model Bin {
  id          Int         @id @default(autoincrement())
  code        String      @unique // printed on the bin and encoded in its QR code
  building    String
  location    String
  wasteStream WasteStream
  // Filled in automatically on the pickup form when this bin is scanned.
  containerSize String?
  notes         String?
  isDemo        Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@map("bin")
}
