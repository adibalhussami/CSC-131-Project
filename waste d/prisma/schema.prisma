generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DRIVER
  SUSTAINABILITY
  SUPERVISOR
  ADMIN
}

enum WasteStream {
  TRASH
  RECYCLING
  COMPOST
  CARDBOARD
  OTHER
}

// Matches the scope's 0/25/50/75/100% categories
enum Fullness {
  P0
  P25
  P50
  P75
  P100
}

enum ServiceStatus {
  COMPLETED
  MISSED
  DELAYED
  INCOMPLETE
}

model User {
  id          String       @id @default(cuid())
  name        String
  username    String       @unique
  passwordHash String      // bcrypt hash, never the plain password
  role        Role         @default(DRIVER)
  canSubmit   Boolean      @default(true)  // can submit collection surveys
  canExport   Boolean      @default(false) // can export reports
  active      Boolean      @default(true)  // admins can disable accounts
  createdAt   DateTime     @default(now())
  collections Collection[]
}

model Building {
  id        String   @id @default(cuid())
  name      String   @unique
  latitude  Float?   // for the optional campus map
  longitude Float?
  bins      Bin[]
}

model Bin {
  id           String       @id @default(cuid())
  binNumber    String       @unique // printed on the bin / encoded in its QR code
  buildingId   String
  building     Building     @relation(fields: [buildingId], references: [id])
  locationNote String?      // e.g. "North entrance"
  wasteStream  WasteStream
  containerType String      // e.g. "Toter", "Dumpster"
  sizeGallons  Int?
  active       Boolean      @default(true)
  collections  Collection[]

  @@index([buildingId])
}

model Collection {
  id              String        @id @default(cuid())
  collectedAt     DateTime      @default(now())
  driverId        String
  driver          User          @relation(fields: [driverId], references: [id])
  binId           String
  bin             Bin           @relation(fields: [binId], references: [id])
  fullness        Fullness
  status          ServiceStatus @default(COMPLETED)
  contaminated    Boolean       @default(false)
  contaminationTypes String[]   // e.g. ["food waste", "plastic bags"]
  overflow        Boolean       @default(false)
  damaged         Boolean       @default(false)
  comments        String?
  photos          Photo[]

  @@index([collectedAt])
  @@index([binId])
  @@index([driverId])
}

model Photo {
  id           String     @id @default(cuid())
  url          String
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
}
